#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## hickory-dns daemon (longrun service): runs the command line cont-init generated (/etc/hickory-dns.args, see
## hickory-dns/KNOWLEDGE.md §"Config-file and data layout"). `exec` makes the daemon this service's process, so
## s6 signals it directly on stop and its stdout lands in the app log.
##
## The daemon NEVER runs as root: the launcher drops to nobody (65534) before the exec, handing down exactly the
## ambient CAP_NET_BIND_SERVICE the :53 bind needs - mechanics and why: hickory-dns/KNOWLEDGE.md §"Port 53
## binding and privileges" (the busybox setpriv applet has no --reuid; /bin/setpriv is the util-linux package).
##
## Fail with a clear message (s6 restarts this service) instead of bash's raw redirect error if config.sh did
## not finish.
if [ ! -r /etc/hickory-dns.args ]; then
  bashio::log.error "/etc/hickory-dns.args is missing - the hickory-dns configuration did not complete (see the earlier log lines for the configuration error)."
  exit 1
fi
read -r -a HICKORY_ARGS </etc/hickory-dns.args
bashio::log.info "Starting hickory-dns as nobody (65534) with ambient CAP_NET_BIND_SERVICE: /usr/bin/hickory-dns ${HICKORY_ARGS[*]}"
exec /bin/setpriv \
  --no-new-privs \
  --reuid 65534 --regid 65534 --clear-groups \
  --inh-caps=+net_bind_service --ambient-caps=+net_bind_service \
  /usr/bin/hickory-dns "${HICKORY_ARGS[@]}"
