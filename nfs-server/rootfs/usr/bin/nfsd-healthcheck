#!/bin/bash
# Docker HEALTHCHECK probe: rpc.nfsd only configures the in-kernel server and exits, so there is no daemon process to
# check - probe the kernel's NFS listener on TCP 2049 at the app IP the last nfsd-apply run recorded (it is the
# address the server actually bound; facts: nfs-server/KNOWLEDGE.md §"Automatic mirror refresh (nfsd-watch)").
set -euo pipefail

APP_IP=""
if [ -s /var/lib/nfs/app.ip ]; then
  read -r APP_IP </var/lib/nfs/app.ip || true
fi
if [ "$APP_IP" = "" ]; then
  ## Fallback for a missing/empty record: self-detect the app IP.
  APP_IP=$(ip addr show | grep 'inet ' | grep -v '127.0.0.1' | awk '{print $2}' | cut -d'/' -f1 | head -n 1)
fi
exec 3<>"/dev/tcp/${APP_IP}/2049"
