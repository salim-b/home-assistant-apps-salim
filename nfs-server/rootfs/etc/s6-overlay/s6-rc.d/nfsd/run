#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

bashio::log.info "Updating NFS exports table..."
exportfs -a

bashio::log.info "Starting nfsd service..."
# NOTE: we accept NFS requests only on the app's IP address (for security hardening)
APP_IP=$(ip addr show | grep 'inet ' | grep -v '127.0.0.1' | awk '{print $2}' | cut -d'/' -f1 | head -n 1)
# NOTE: NFSv2 is not supported anymore by nfsd, so we mustn't specify `--no-nfs-version 2` (errors with: '2: Unsupported version')
NFSD_CMD="rpc.nfsd \
  --no-nfs-version 3 \
  --no-udp \
  --host ${APP_IP} \
  --lease-time $(bashio::config 'lease_time') \
  $(bashio::config 'n_threads')"

# Add optional flags
if bashio::config.has_value 'grace_time'; then
  NFSD_CMD="${NFSD_CMD} --grace-time $(bashio::config 'grace_time')"
fi

bashio::log.info "Executing nfsd with: ${NFSD_CMD}"
# shellcheck disable=SC2086
exec s6-notifyoncheck -d -s 300 -w 300 -n 0 ${NFSD_CMD}
