#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Take down the S6 supervision tree when service fails
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

# shellcheck disable=SC2155
readonly exit_code_container=$(</run/s6-linux-init-container-results/exitcode)
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"
readonly service="nfsd"

# Log service termination details
bashio::log.info \
  "Service ${service} exited with code ${exit_code_service} (by signal ${exit_code_signal})"

# Clean up NFS exports regardless of exit code
bashio::log.info "Unexporting NFS shares..."
exportfs -au

# Handle signal-based termination (exit code 256)
if [[ "${exit_code_service}" -eq 256 ]]; then
  # Only update container exit code if it's still 0 (no previous error)
  if [[ "${exit_code_container}" -eq 0 ]]; then
    echo $((128 + exit_code_signal)) >/run/s6-linux-init-container-results/exitcode
    bashio::log.info "Updated container exit code to $((128 + exit_code_signal))"
  fi
  # If terminated by SIGTERM (15), halt the container
  if [[ "${exit_code_signal}" -eq 15 ]]; then
    bashio::log.info "Service ${service} received SIGTERM, halting container"
    exec /run/s6/basedir/bin/halt
  fi
# Handle non-zero exit codes (actual failures)
elif [[ "${exit_code_service}" -ne 0 ]]; then
  # Only update container exit code if it's still 0 (no previous error)
  if [[ "${exit_code_container}" -eq 0 ]]; then
    echo "${exit_code_service}" >/run/s6-linux-init-container-results/exitcode
    bashio::log.info "Updated container exit code to ${exit_code_service}"
  fi

  # Halt container to prevent restart loops
  bashio::log.error "Service ${service} failed, halting container"
  exec /run/s6/basedir/bin/halt
fi

# Normal exit (code 0), allow restart
bashio::log.info "Service ${service} completed normally (exit code ${exit_code_service})"
