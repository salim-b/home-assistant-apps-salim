#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## Share-mount watcher (longrun): a drive's unplug/replug changes the mount object backing the configured share paths
## while the pseudo file system root's mirrors are private bind clones outside that propagation chain - they keep
## serving a detached superblock clone until they are rebound and the kernel server is restarted. This watcher detects
## the change (nfsd-apply --check) and cycles the kernel server, no manual app restart needed.
## Facts: nfs-server/KNOWLEDGE.md §"Automatic mirror refresh (nfsd-watch)".

## Poll interval (seconds). NFSD_WATCH_INTERVAL overrides the 30 s default; invalid values fall back to it, floored
## at 5 s so a bogus value cannot busy-cycle the tick.
INTERVAL="${NFSD_WATCH_INTERVAL:-30}"
case "$INTERVAL" in
  '' | *[!0-9]*)
    bashio::log.warning "Invalid NFSD_WATCH_INTERVAL '${INTERVAL}' - using the 30 s default."
    INTERVAL=30
    ;;
esac
[ "$INTERVAL" -ge 5 ] || INTERVAL=5
PENDING_FILE=/var/lib/nfs/nfsd-restart-pending

while true; do
  sleep "$INTERVAL"

  ## Detect (read-only): 0 = clean, 3 = a share's backing mount changed, 1 = check failure (keep-current guard:
  ## a nonzero nfsd-apply always logs its own fatal reason first).
  RC=0
  /usr/bin/nfsd-apply --quiet --check || RC=$?

  if [ "$RC" = 1 ] && [ ! -e "$PENDING_FILE" ]; then
    bashio::log.warning "Checking the NFS share configuration failed - keeping the current configuration."
    continue
  fi
  if [ "$RC" = 0 ] && [ ! -e "$PENDING_FILE" ]; then
    continue
  fi

  ## Change detected: cycle the kernel server in the proven nfsd-stop order - rpc.nfsd 0 FIRST (it releases the
  ## kernel's pins on the mirrors' old superblocks, so the apply's umounts succeed), minus the down script's mirror
  ## teardown: the apply below recreates the mirrors and nfsd-start re-exports. Deliberately NOT an s6-rc restart
  ## (not reentrant from inside a service): nfs-server/KNOWLEDGE.md §"Automatic mirror refresh (nfsd-watch)".
  if [ "$RC" = 3 ]; then
    bashio::log.info "Share mount state changed - re-applying the NFS configuration and restarting the NFS server"
    ## Mark the cycle pending BEFORE tearing the server down: every subsequent tick must keep trying to get the
    ## server back up, even when the by-then-clean detection state would otherwise skip the restart.
    touch "$PENDING_FILE"
    rpc.nfsd 0 || true
    exportfs -au || true
    if ! /usr/bin/nfsd-apply --quiet; then
      bashio::log.warning "Re-applying the NFS configuration failed - retrying on the next tick."
      continue
    fi
  fi

  ## (Re)start the kernel server - also the retry path for a cycle that failed after the marker was set (the marker
  ## makes the retry survive the by-then-clean detection state; a failed check with a pending marker falls through).
  if /etc/s6-overlay/scripts/nfsd-start; then
    rm -f "$PENDING_FILE"
  else
    touch "$PENDING_FILE"
    bashio::log.warning "Restarting the NFS server failed - retrying on the next tick."
  fi
done
