#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## Foreground rpc.mountd with both legacy listeners disabled (binds no ports): NFSv4 clients never use the MOUNT
## protocol, but the kernel's nfsd resolves NFSv4 paths via export-cache upcalls that mountd services. Full rationale:
## nfs-server/KNOWLEDGE.md §"NFSv4 needs rpc.mountd...".
exec rpc.mountd -F -N 2 -N 3
