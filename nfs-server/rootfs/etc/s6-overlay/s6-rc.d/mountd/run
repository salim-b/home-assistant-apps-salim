#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## Foreground rpc.mountd with both legacy listeners disabled (binds no ports): the kernel's nfsd resolves NFSv4
## paths via export-cache upcalls that mountd must service (nfs-server/KNOWLEDGE.md §"mountd and the pseudo file system root").
exec rpc.mountd -F -N 2 -N 3
