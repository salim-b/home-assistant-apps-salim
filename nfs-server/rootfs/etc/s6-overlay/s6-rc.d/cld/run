#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## NFSv4 client-recovery tracker daemon (nfsdcld, longrun): answers the kernel's cld-tracker upcalls over the
## rpc_pipefs mounted in this container, storing client identities on /data for cross-restart reclaims. Starts
## before the nfsd oneshot: nfs-server/KNOWLEDGE.md §"NFSv4 client state recovery (nfsdcld + per-netns rpc_pipefs)".
exec nfsdcld -F -p /var/lib/nfs/rpc_pipefs -s /data/nfsdcld
