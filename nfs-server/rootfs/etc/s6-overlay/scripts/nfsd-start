#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## Log the stderr captured from a failed command, one log line per stderr line:
## the app's log must state the actual cause of a failure - a bare "failed"
## message sent users checking their app configuration for what were
## image-internal problems. An empty capture is logged explicitly (a silent
## failing command is itself diagnostic information).
log_captured_stderr() {
  if [ -s "$1" ]; then
    while IFS= read -r line; do
      bashio::log.fatal "    ${line}"
    done <"$1"
  else
    bashio::log.fatal "    (no error output)"
  fi
}

## Refresh the kernel's export table from /etc/exports (generated by cont-init).
bashio::log.info "Updating NFS exports table..."
ERRFILE="$(mktemp)"
if ! exportfs -a 2>"$ERRFILE"; then
  bashio::log.fatal "Updating the NFS exports table failed (exportfs -a):"
  log_captured_stderr "$ERRFILE"
  rm -f "$ERRFILE"
  exit 1
fi
if [ -s "$ERRFILE" ]; then
  while IFS= read -r line; do
    bashio::log.info "exportfs: ${line}"
  done <"$ERRFILE"
fi
rm -f "$ERRFILE"

bashio::log.info "Starting nfsd service..."
# Accept NFS requests only on the app's own IP (security hardening).
APP_IP=$(ip addr show | grep 'inet ' | grep -v '127.0.0.1' | awk '{print $2}' | cut -d'/' -f1 | head -n 1)
# --no-nfs-version 3 keeps the setup NFSv4-only (rpc.nfsd writes its default
# version set to the kernel; semantics + the -N/-V 2/4-only quirk:
# nfs-server/KNOWLEDGE.md §"rpc.nfsd is not a daemon").
# The grace/lease ratio (grace defaults to the lease time): with the shipped
# nfsdcld recovery tracking the grace is only paid when client records exist
# (see nfs-server/KNOWLEDGE.md §"The grace period..."); a user-configured
# grace_time overrides the default.
## NOTE: build this command as an array and execute it with "${NFSD_CMD[@]}": a
## command built as a *string* must be executed unquoted (word splitting), and
## the lint's quoting hardening (shellharden) quotes exactly that away -
## `"$NFSD_CMD"` makes the whole string one literal command name ("command not
## found", the 0.6.1 release breakage). An array is quoting-stable by
## construction. Repository-root AGENTS.md tool notes carry the lesson.
NFSD_CMD=(
  rpc.nfsd
  --no-nfs-version 3
  --no-udp
  --host "$APP_IP"
  --lease-time "$(bashio::config 'lease_time')"
  --grace-time "$(bashio::config 'grace_time' "$(bashio::config 'lease_time')")"
  "$(bashio::config 'n_threads')"
)

bashio::log.info "Executing nfsd with: ${NFSD_CMD[*]}"
ERRFILE="$(mktemp)"
STATUS=0
"${NFSD_CMD[@]}" 2>"$ERRFILE" || STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  bashio::log.fatal "Starting the NFS server failed: rpc.nfsd exited with status ${STATUS} (command: ${NFSD_CMD[*]})."
  bashio::log.fatal "rpc.nfsd's error output:"
  log_captured_stderr "$ERRFILE"
  rm -f "$ERRFILE"
  exit 1
fi
if [ -s "$ERRFILE" ]; then
  while IFS= read -r line; do
    bashio::log.info "rpc.nfsd: ${line}"
  done <"$ERRFILE"
fi
rm -f "$ERRFILE"

# rpc.nfsd exits after configuring the in-kernel server - hence the s6-rc oneshot
# (nfs-server/KNOWLEDGE.md §"rpc.nfsd is not a daemon").
bashio::log.info "NFS server started (kernel threads running)."

# Verify and log the version set rpc.nfsd configured.
NFS_VERSIONS="$(</proc/fs/nfsd/versions)"
bashio::log.info "Enabled NFS versions: ${NFS_VERSIONS}"
if grep -qE '\+(2|3)( |$)' <<<"$NFS_VERSIONS"; then
  bashio::log.warning "NFSv2 or NFSv3 is still enabled at kernel level despite the request to disable it."
fi
