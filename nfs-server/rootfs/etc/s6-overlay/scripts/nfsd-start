#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## Log a failed command's captured stderr as FATAL lines, one per stderr line
## (an empty capture is logged explicitly - a silent failure is itself diagnostic).
log_captured_stderr() {
  if [ -s "$1" ]; then
    while IFS= read -r line; do
      bashio::log.fatal "    ${line}"
    done <"$1"
  else
    bashio::log.fatal "    (no error output)"
  fi
}

## Refresh the kernel's export table from /etc/exports (generated by cont-init).
bashio::log.info "Updating NFS exports table..."
ERRFILE="$(mktemp)"
if ! exportfs -a 2>"$ERRFILE"; then
  bashio::log.fatal "Updating the NFS exports table failed (exportfs -a):"
  log_captured_stderr "$ERRFILE"
  rm -f "$ERRFILE"
  exit 1
fi
if [ -s "$ERRFILE" ]; then
  while IFS= read -r line; do
    bashio::log.info "exportfs: ${line}"
  done <"$ERRFILE"
fi
rm -f "$ERRFILE"

bashio::log.info "Starting nfsd service..."
## The rpc.nfsd command line is generated by nfsd-apply (one shared generator for boot and the nfsd-watch restarts;
## the args are invariant while the app runs - root KNOWLEDGE.md §"Supervisor: option schema quirks").
## Facts: nfs-server/KNOWLEDGE.md §"`rpc.nfsd` is not a daemon" / §"Grace period".
if [ ! -s /etc/nfsd.args ]; then
  bashio::log.fatal "Missing or empty /etc/nfsd.args - run nfsd-apply first (nfsd-start consumes its output)."
  exit 1
fi
## NOTE: execute as an array ("${NFSD_CMD[@]}") - a string-built command must run unquoted (word splitting), which
## the lint's quoting hardening quotes away: `"$NFSD_CMD"` becomes one literal command name (the 0.6.1 release breakage).
read -r -a NFSD_CMD </etc/nfsd.args

bashio::log.info "Executing nfsd with: ${NFSD_CMD[*]}"
ERRFILE="$(mktemp)"
STATUS=0
"${NFSD_CMD[@]}" 2>"$ERRFILE" || STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  bashio::log.fatal "Starting the NFS server failed: rpc.nfsd exited with status ${STATUS} (command: ${NFSD_CMD[*]})."
  bashio::log.fatal "rpc.nfsd's error output:"
  log_captured_stderr "$ERRFILE"
  rm -f "$ERRFILE"
  exit 1
fi
if [ -s "$ERRFILE" ]; then
  while IFS= read -r line; do
    bashio::log.info "rpc.nfsd: ${line}"
  done <"$ERRFILE"
fi
rm -f "$ERRFILE"

# rpc.nfsd exits after configuring the in-kernel server - hence the s6-rc oneshot
# (nfs-server/KNOWLEDGE.md §"`rpc.nfsd` is not a daemon").
bashio::log.info "NFS server started (kernel threads running)."

# Verify and log the version set rpc.nfsd configured.
NFS_VERSIONS="$(</proc/fs/nfsd/versions)"
bashio::log.info "Enabled NFS versions: ${NFS_VERSIONS}"
if grep -qE '\+(2|3)( |$)' <<<"$NFS_VERSIONS"; then
  bashio::log.warning "NFSv2 or NFSv3 is still enabled at kernel level despite the request to disable it."
fi
