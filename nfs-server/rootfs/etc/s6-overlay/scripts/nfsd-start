#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

bashio::log.info "Updating NFS exports table..."
exportfs -a

bashio::log.info "Starting nfsd service..."
# NOTE: we accept NFS requests only on the app's IP address (for security hardening)
APP_IP=$(ip addr show | grep 'inet ' | grep -v '127.0.0.1' | awk '{print $2}' | cut -d'/' -f1 | head -n 1)
# NOTE: rpc.nfsd writes its default version set (NFSv3+NFSv4) to the kernel,
# hence `--no-nfs-version 3` is what keeps this setup NFSv4-only (see
# KNOWLEDGE.md in the app's source repository).
# NOTE: the NFSv4 grace period defaults to the lease time here (the kernel's
# own default ratio is 1:1). The app's client-recovery tracking (nfsdcld; see
# cont-init.d/config.sh and s6-rc.d/cld) makes this costless in the common
# cases: a fresh boot with no recorded clients skips the grace entirely (the
# kernel's skip path), and it ends early once all recorded clients have
# reclaimed. When set, a user-configured `grace_time` overrides the default.
NFSD_CMD="rpc.nfsd \
  --no-nfs-version 3 \
  --no-udp \
  --host ${APP_IP} \
  --lease-time $(bashio::config 'lease_time') \
  --grace-time $(bashio::config 'grace_time' "$(bashio::config 'lease_time')") \
  $(bashio::config 'n_threads')"

bashio::log.info "Executing nfsd with: ${NFSD_CMD}"
# shellcheck disable=SC2086
if ${NFSD_CMD}; then
  # rpc.nfsd exits after configuring the in-kernel server - hence the
  # s6-rc `oneshot` (see KNOWLEDGE.md in the app's source repository).
  bashio::log.info "NFS server started (kernel threads running)."

  # Verify and log the version set rpc.nfsd configured.
  NFS_VERSIONS="$(</proc/fs/nfsd/versions)"
  bashio::log.info "Enabled NFS versions: ${NFS_VERSIONS}"
  if grep -qE '\+(2|3)( |$)' <<<"${NFS_VERSIONS}"; then
    bashio::log.warning "NFSv2 or NFSv3 is still enabled at kernel level despite the request to disable it."
  fi
else
  bashio::log.fatal "Starting the NFS server failed!"
  bashio::log.fatal "Please check the app configuration (share paths/options, thread count, ...) and the log messages above."
  exit 1
fi
