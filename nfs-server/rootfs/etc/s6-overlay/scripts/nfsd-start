#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

bashio::log.info "Updating NFS exports table..."
exportfs -a

bashio::log.info "Starting nfsd service..."
# Accept NFS requests only on the app's own IP (security hardening).
APP_IP=$(ip addr show | grep 'inet ' | grep -v '127.0.0.1' | awk '{print $2}' | cut -d'/' -f1 | head -n 1)
# --no-nfs-version 3 keeps the setup NFSv4-only (rpc.nfsd writes its default
# version set to the kernel; semantics + the -N/-V 2/4-only quirk:
# nfs-server/KNOWLEDGE.md §"rpc.nfsd is not a daemon").
# The grace/lease ratio (grace defaults to the lease time): with the shipped
# nfsdcld recovery tracking the grace is only paid when client records exist
# (see nfs-server/KNOWLEDGE.md §"The grace period..."); a user-configured
# grace_time overrides the default.
## NOTE: build this command as an array and execute it with "${NFSD_CMD[@]}": a
## command built as a *string* must be executed unquoted word-splitting, and the
## lint's quoting hardening (shellharden) quotes exactly that away - `"$NFSD_CMD"`
## makes the whole string one literal command name ("command not found", the 0.6.1
## release breakage). An array is quoting-hardening-stable by construction.
NFSD_CMD=(
  rpc.nfsd
  --no-nfs-version 3
  --no-udp
  --host "$APP_IP"
  --lease-time "$(bashio::config 'lease_time')"
  --grace-time "$(bashio::config 'grace_time' "$(bashio::config 'lease_time')")"
  "$(bashio::config 'n_threads')"
)

bashio::log.info "Executing nfsd with: ${NFSD_CMD[*]}"
if "${NFSD_CMD[@]}"; then
  # rpc.nfsd exits after configuring the in-kernel server - hence the s6-rc oneshot
  # (nfs-server/KNOWLEDGE.md §"rpc.nfsd is not a daemon").
  bashio::log.info "NFS server started (kernel threads running)."

  # Verify and log the version set rpc.nfsd configured.
  NFS_VERSIONS="$(</proc/fs/nfsd/versions)"
  bashio::log.info "Enabled NFS versions: ${NFS_VERSIONS}"
  if grep -qE '\+(2|3)( |$)' <<<"$NFS_VERSIONS"; then
    bashio::log.warning "NFSv2 or NFSv3 is still enabled at kernel level despite the request to disable it."
  fi
else
  bashio::log.fatal "Starting the NFS server failed!"
  bashio::log.fatal "Please check the app configuration (share paths/options, thread count, ...) and the log messages above."
  exit 1
fi
