#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# Best-effort cleanup: failures must not block container shutdown, hence no `set -e`.
set -uo pipefail

bashio::log.info "Stopping nfsd kernel threads..."
rpc.nfsd 0 || true

bashio::log.info "Unexporting NFS shares..."
exportfs -au || true

## Tear down the pseudo file system root bind mounts (per-share mirrors; deepest paths first - mirrors may nest)
PSEUDO_ROOT="/data/pseudo_root"
bashio::log.info "Unmounting the share mirrors under the pseudo file system root..."
SHARES=$(bashio::config 'shares' || true)
if bashio::var.has_value "$SHARES"; then
  PATHS=""
  while IFS= read -r share; do
    path=$(bashio::jq "$share" '.path' || true)
    [ "$path" != "" ] || continue
    PATHS+="${path}\n"
  done < <(echo "$SHARES")
  printf '%b' "$PATHS" | awk '{print length, $0}' | sort -rn | cut -d' ' -f2- \
    | while IFS= read -r path; do
      umount "${PSEUDO_ROOT}${path}" 2>/dev/null || true
    done
fi

## The rpc_pipefs mount is deliberately NOT unmounted: the cld daemon holds its upcall pipe open (EBUSY), and the
## mount evaporates with the container's mount namespace anyway.
