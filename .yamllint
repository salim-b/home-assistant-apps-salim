extends: default

rules:
  # app config descriptions and translations use long lines intentionally, and
  # Renovate pins workflow action refs to full commit SHAs with a version
  # comment (`uses: owner/repo/actions/name@<40-char-sha> # v1.2.3`) - those
  # scalars are single-line by YAML grammar and cannot be wrapped
  line-length:
    max: 140
    level: warning
  # HA app files don't use a leading '---'
  document-start: {present: false}
  comments: {min-spaces-from-content: 1}
  truthy: {check-keys: false}
