#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## Generate the hd-idle command line from the app options (validated, written to <args-file>, default /etc/hd-idle.args)
## for the s6 run script – hd-idle has no config file, everything is argv. Full generation (default) writes the args
## file plus two companions: the drives file (hd-idle-pmfix) and the resolution baseline (the state file --check
## replays: exit 0 = unchanged, 3 = changed (regeneration due), other = failure). CLI semantics, quiet-mode contract,
## drives-file format, baseline replay: hd-idle/KNOWLEDGE.md.

QUIET=0
CHECK=0
ARGS_FILE=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --quiet) QUIET=1 ;;
    --check) CHECK=1 ;;
    *) ARGS_FILE="$1" ;;
  esac
  shift
done
ARGS_FILE="${ARGS_FILE:-/etc/hd-idle.args}"
LOG_FILE=/data/hd-idle.log

qlog_info() {
  [ "$QUIET" = 1 ] || bashio::log.info "$@"
}

## Expected-transient warnings (detached drive, non-sd* entry), suppressed in quiet mode – surfaced once per boot by
## the non-quiet cont-init run; genuine failures (bashio::exit.nok) always log.
qlog_warning() {
  [ "$QUIET" = 1 ] || bashio::log.warning "$@"
}

## Every emitted token must be space-free: the run script word-splits the args file, so whitespace would corrupt the
## argv. The supervisor schema blocks it for saved options; this covers hand-edited options.json.
require_space_free() {
  local what="$1" value="$2"
  [[ "$value" != *[[:space:]]* ]] \
    || bashio::exit.nok "Invalid ${what} '${value}': must not contain whitespace."
}

## Companion files next to the args file (<stem>.<suffix> for *.args paths, <args-file>.<suffix> otherwise – the
## watcher's /tmp candidates). The derivation is mirrored inline in the hd-idle-watch run script.
companion_file() {
  local args_file="$1" suffix="$2" file
  case "$args_file" in
    *.args) file="${args_file%.args}.${suffix}" ;;
    *) file="${args_file}.${suffix}" ;;
  esac
  [[ "$file" == */* ]] || file="./${file}"
  printf '%s' "$file"
}
DRIVES_FILE=$(companion_file "$ARGS_FILE" drives)
STATE_FILE=$(companion_file "$ARGS_FILE" resolution)

## ---------------------------------------------------------------------------
## Device resolution
## ---------------------------------------------------------------------------

## Parent block device of a partition name (sdi1 -> sdi, nvme0n1p2 -> nvme0n1). A trailing "p" is only stripped when
## preceded by a digit, so genuinely named disks (e.g. "sdp") survive; whole-disk names like nvme0n1/mmcblk0 lose
## their final digit – harmless, since only the sd* subset is ever pinned, recorded, or compared.
parent_disk() {
  local name="$1"
  ## dm-* names have no partition suffixes; holder attribution via /sys/block/*/holders (resolve_device).
  if [[ "$name" == dm-* ]]; then
    printf '%s' "$name"
    return
  fi
  while [[ "$name" =~ [0-9]$ ]]; do
    name="${name%?}"
  done
  if [[ "$name" =~ [0-9]p$ ]]; then
    name="${name%p}"
  fi
  printf '%s' "$name"
}

## Resolve a configured device value (by-* path, /dev node, or bare kernel name) to its kernel base name; returns 1
## if the path does not resolve (e.g. drive currently detached).
resolve_device() {
  local dev="$1" target base holder
  case "$dev" in
    /dev/*)
      target=$(readlink -f "$dev" 2>/dev/null || true)
      if [ "$target" = "" ]; then
        return 1
      fi
      ## busybox readlink -f prints the INPUT path itself when the final component does not exist: without this
      ## existence check a detached drive is misclassified as "not an sd* disk" and silently dropped from the
      ## configuration instead of taking the pass-through path.
      if [ ! -e "$target" ]; then
        return 1
      fi
      base="${target##*/}"
      ;;
    *)
      base="$dev"
      ;;
  esac
  ## A dm device (e.g. LUKS) attributes to its holding disk (hd-idle attributes dm stats to the holder as well).
  if [[ "$base" =~ ^dm-[0-9]+$ ]]; then
    holder=""
    for entry in "/sys/class/block/${base}/holders/"*; do
      [ -e "$entry" ] || continue
      holder="${entry##*/}"
      break
    done
    if [ "$holder" = "" ]; then
      return 1
    fi
    base="$holder"
  fi
  printf '%s' "$base"
}

## ---------------------------------------------------------------------------
## System disk detection (always on – HA's own partitions are never spun down)
## ---------------------------------------------------------------------------

## Three independent layers protect the system disk (hd-idle/KNOWLEDGE.md §"Monitoring scope"); this is the second:
## the supervisor refuses system-used devices (1); the boot device and hassos-* partitions are pinned to idle 0 here,
## first-match-wins (2); hd-idle only monitors sd*/dm-* anyway (3). Detection is set-based, order carries no semantics.

## All detected system-disk base names (deduplicated) and their sd* subset.
SYSTEM_DISKS=()
SYSTEM_SD_DISKS=()
ROOT_SOURCE=""

## Dedup via an assoc array – this runs on every --check tick too, so keep it cheap.
declare -A SYSTEM_SEEN=()
add_system_disk() {
  local parent
  parent=$(parent_disk "${1}")
  [ "$parent" != "" ] || return 0
  [[ -z "${SYSTEM_SEEN[${parent}]+x}" ]] || return 0
  SYSTEM_SEEN["${parent}"]=1
  SYSTEM_DISKS+=("$parent")
}

detect_system_disks() {
  ## The kernel command line's root= parameter (/proc/cmdline is not namespaced), resolved via the udev symlink trees
  ## in /dev/disk. /proc/cmdline has no trailing newline: read exits nonzero at EOF – the words are assigned all the same.
  local -a cmdline_words=()
  read -r -a cmdline_words </proc/cmdline || true
  local root_param="" root_link="" resolved="" word link disk
  for word in "${cmdline_words[@]}"; do
    case "$word" in
      root=*) root_param="${word#root=}" ;;
    esac
  done
  case "$root_param" in
    UUID=*) root_link="/dev/disk/by-uuid/${root_param#UUID=}" ;;
    PARTUUID=*) root_link="/dev/disk/by-partuuid/${root_param#PARTUUID=}" ;;
    PARTLABEL=*) root_link="/dev/disk/by-partlabel/${root_param#PARTLABEL=}" ;;
    /dev/*) root_link="$root_param" ;;
    *) root_link="" ;;
  esac
  if [ "$root_link" != "" ] && resolved=$(readlink -f "$root_link" 2>/dev/null); then
    add_system_disk "${resolved##*/}"
    ROOT_SOURCE="root=${root_param}"
  else
    ROOT_SOURCE=""
  fi

  ## Every hassos-* partition sits on the system disk; partlabel resolution also covers setups where root= is unresolvable.
  for link in /dev/disk/by-partlabel/hassos-*; do
    [ -e "$link" ] || continue
    resolved=$(readlink -f "$link")
    add_system_disk "${resolved##*/}"
  done

  ## Only sd* disks can be pinned (hd-idle monitors nothing else; hd-idle/KNOWLEDGE.md §"Monitoring scope").
  for disk in "${SYSTEM_DISKS[@]}"; do
    if [[ "$disk" =~ ^sd[a-z]+$ ]]; then
      SYSTEM_SD_DISKS+=("$disk")
    else
      qlog_info "System disk ${disk} detected - not an sd* device, hd-idle ignores it anyway."
    fi
  done
  if [ "${#SYSTEM_SD_DISKS[@]}" -gt 0 ]; then
    qlog_info "Excluding the system disk(s) from spin-down: ${SYSTEM_SD_DISKS[*]} (${ROOT_SOURCE:+${ROOT_SOURCE}; }hassos-* partitions)"
  elif [ "${#SYSTEM_DISKS[@]}" -eq 0 ]; then
    ## Boot-time concern only (cont-init warns once loudly); the watcher must not repeat it per tick.
    qlog_info "Could not identify the system disk via root= or hassos-* partlabels. Only listed drives are ever touched; do not list the system disk."
  else
    qlog_info "System disk(s) identified but not sd* devices - hd-idle ignores them anyway."
  fi
}

## ---------------------------------------------------------------------------
## Baseline replay (--check): the watcher's per-tick detection
## ---------------------------------------------------------------------------

## The watcher's per-tick detection (nfsd-apply --check pattern, nfs-server commit d78c7ea): re-verify ONLY the
## recorded detection facts – options cannot change mid-run, so if they all hold, the installed files are exactly
## what a regeneration would produce. Exit 0 = unchanged, 3 = changed (resolution/system-disk drift or installed-file
## drift), any other nonzero = check failure. Facts: hd-idle/KNOWLEDGE.md §"hd-idle-watch design".
check_baseline_replay() {
  ## No baseline (nothing recorded yet / boot not finished): regeneration due.
  [ -s "$STATE_FILE" ] || return 3

  local tag rest dev outcome sha
  local recorded_args_sha="" recorded_drives_sha="" recorded_system=""
  local -A recorded_resolutions=()

  ## Line-based state format: 'args <sha256>', 'drives <sha256>', 'system <sd* names...>',
  ## 'dev <configured device> <outcome>' (outcome: kernel name, PASSTHRU, or IGNORED). Device values are space-free
  ## (require_space_free), so plain field splitting is safe.
  while read -r tag rest; do
    case "$tag" in
      args) recorded_args_sha="$rest" ;;
      drives) recorded_drives_sha="$rest" ;;
      system) recorded_system="$rest" ;;
      dev)
        dev=""
        outcome=""
        read -r dev outcome <<<"$rest" || true
        if [ "$dev" != "" ] && [ "$outcome" != "" ]; then
          recorded_resolutions["${dev}"]="$outcome"
        fi
        ;;
    esac
  done <"$STATE_FILE"

  ## The installed files must still be exactly what this baseline was generated from: this makes hand-edits,
  ## corruption and partial installs (state file = commit point) detection-equivalent to a regeneration comparison.
  [ "$recorded_args_sha" != "" ] && [ "$recorded_drives_sha" != "" ] || return 3
  sha=$(sha256sum "$ARGS_FILE" 2>/dev/null) || return 3
  [ "${sha%% *}" = "$recorded_args_sha" ] || return 3
  sha=$(sha256sum "$DRIVES_FILE" 2>/dev/null) || return 3
  [ "${sha%% *}" = "$recorded_drives_sha" ] || return 3

  ## System-disk set drift: a re-enumeration can move the system disk's kernel name.
  local -A recorded_system_set=()
  if [ "$recorded_system" != "" ]; then
    local -a recorded_system_fields=()
    read -r -a recorded_system_fields <<<"$recorded_system" || true
    for disk in "${recorded_system_fields[@]}"; do
      recorded_system_set["${disk}"]=1
    done
  fi
  [ "${#recorded_system_set[@]}" -eq "${#SYSTEM_SD_DISKS[@]}" ] || return 3
  for disk in "${SYSTEM_SD_DISKS[@]}"; do
    [[ -n "${recorded_system_set[${disk}]+x}" ]] || return 3
  done

  ## Per-device resolution drift: re-resolve every recorded device, compare the outcome class.
  local current="" current_outcome=""
  for dev in "${!recorded_resolutions[@]}"; do
    if current=$(resolve_device "$dev"); then
      if [[ "$current" =~ ^sd[a-z]+$ ]]; then
        current_outcome="$current"
      else
        current_outcome="IGNORED"
      fi
    else
      current_outcome="PASSTHRU"
    fi
    [ "$current_outcome" = "${recorded_resolutions[${dev}]}" ] || return 3
  done

  return 0
}

if [ "$CHECK" = 1 ]; then
  detect_system_disks
  RC=0
  check_baseline_replay || RC=$?
  exit "$RC"
fi

## ---------------------------------------------------------------------------
## Configuration (full generation only)
## ---------------------------------------------------------------------------

DISKS=$(bashio::config 'disks')

detect_system_disks

## ---------------------------------------------------------------------------
## Drive inventory (helps users map by-id paths and labels to kernel names)
## ---------------------------------------------------------------------------

## Boot-time UX only (non-quiet cont-init run). Since the --check baseline replay the watcher never
## reaches this code; the guard just keeps the inventory out of regeneration ticks. Label sources,
## escaping and known gaps: hd-idle/KNOWLEDGE.md §"Drive inventory".

## udev escapes bytes outside its safe set in /dev/disk/by-* link names as \xNN (a space becomes
## \x20); %b resolves exactly that escape alphabet and passes raw bytes through unchanged.
decode_udev_name() {
  printf '%b' "$1"
}

## Fill MAP (nameref) from the udev symlink tree DIR: resolved node's kernel name -> decoded label
## (sda1, or the disk name itself for a whole-disk filesystem). Dangling links (vanished filesystems)
## are skipped – the same staleness guard as the by-id scan in the inventory below.
fill_label_map() {
  local -n map=$2
  local link target
  for link in "$1"/*; do
    [ -L "$link" ] || continue
    target=$(readlink -f "$link" 2>/dev/null) || continue
    [ -e "$target" ] || continue
    # shellcheck disable=SC2034  # nameref: the write lands in the caller's map
    map["${target##*/}"]=$(decode_udev_name "${link##*/}")
  done
}

## Label fragment for one inventory line: the first partition in start order that carries a
## filesystem label (preferred) and/or a GPT partition label (fallback; both shown when they
## differ) – or, on an unpartitioned disk, the whole-disk filesystem label. Empty when nothing
## is labeled. Reads sysfs and the label maps only: no device-node access, so standby drives
## stay asleep (hd-idle/KNOWLEDGE.md §"Drive inventory").
drive_label_info() {
  local block="$1" name="$2" part_dir part start fs pl line
  local -a parts=()
  for part_dir in "${block}/${name}"[0-9]*; do
    [ -d "$part_dir" ] || continue
    part="${part_dir##*/}"
    start=$(cat "${part_dir}/start" 2>/dev/null) || start=""
    ## No readable start file: the sentinel sorts the partition last (cosmetic order only).
    if [ "$start" = "" ]; then
      start=999999999999
    fi
    parts+=("${start} ${part}")
  done
  if [ "${#parts[@]}" -gt 0 ]; then
    while IFS= read -r line; do
      part="${line#* }"
      fs="${FS_LABELS[$part]:-}"
      pl="${PART_LABELS[$part]:-}"
      if [ "$fs" = "$pl" ]; then
        pl=""
      fi
      if [ "$fs" != "" ]; then
        printf 'label (%s): %s' "$part" "$fs"
        if [ "$pl" != "" ]; then
          printf ', partlabel (%s): %s' "$part" "$pl"
        fi
      elif [ "$pl" != "" ]; then
        printf 'partlabel (%s): %s' "$part" "$pl"
      else
        continue
      fi
      return 0
    done < <(printf '%s\n' "${parts[@]}" | sort -n)
  elif [ "${FS_LABELS[$name]:-}" != "" ]; then
    printf 'label: %s' "${FS_LABELS[$name]}"
  fi
  return 0
}

if [ "$QUIET" = 0 ]; then
  declare -A FS_LABELS=() PART_LABELS=()
  fill_label_map /dev/disk/by-label FS_LABELS
  fill_label_map /dev/disk/by-partlabel PART_LABELS

  qlog_info "Detected sd* disks:"
  for block in /sys/block/sd*; do
    [ -e "$block" ] || continue
    name="${block##*/}"
    model=$(xargs <<<"$(cat "${block}/device/model" 2>/dev/null || true)" || true)
    byid=""
    for link in /dev/disk/by-id/*; do
      [ -L "$link" ] || continue
      if [ "$(readlink -f "$link")" = "/dev/${name}" ]; then
        byid="${link##*/}"
        break
      fi
    done
    labelinfo=$(drive_label_info "$block" "$name")
    info=""
    if [ "$byid" != "" ]; then
      info="by-id: ${byid}"
    fi
    if [ "$labelinfo" != "" ]; then
      info="${info:+${info}, }${labelinfo}"
    fi
    qlog_info "  ${name}: ${model:-unknown}${info:+ (${info})}"
  done
fi

## ---------------------------------------------------------------------------
## Drive configuration -> per-device entries
## ---------------------------------------------------------------------------

## The global idle stays pinned to 0: unlisted drives (and runtime-appearing ones) are never touched – HAOS grants
## device access per listed drive only. Every drive entry carries explicit -i/-c/-p (its own settings; there are no
## global defaults – the CLI's built-in defaults cover only what no entry reaches).
ARGS=(-s 1 -i 0)

DRIVES_LINES=()
## System disks are exclusion entries (idle 0): never treatment targets, hence pm-flag 0; the command-type column is
## "-" (no spin-down command is ever issued for them).
for disk in "${SYSTEM_SD_DISKS[@]}"; do
  DRIVES_LINES+=("${disk} 0 - 0")
done

for disk in "${SYSTEM_SD_DISKS[@]}"; do
  ARGS+=(-a "$disk" -i 0)
done

N_DRIVES=0
declare -A SEEN_DEVICES=()
## Baseline records for the state file: every configured device (options order, deterministic) with its resolution
## OUTCOME (kernel name / PASSTHRU / IGNORED) – fully determines the generated configuration given immutable options.
RECORD_DEVICES=()
declare -A RECORD_RESOLVED=()
record_resolution() {
  RECORD_DEVICES+=("${1}")
  RECORD_RESOLVED["${1}"]="${2}"
}

## bashio::config returns one compact JSON object per line for list-of-object options
## (hd-idle/KNOWLEDGE.md §"bashio option parsing (list-of-object options)").
while IFS= read -r disk; do
  [ "$disk" != "" ] || continue
  N_DRIVES=$((N_DRIVES + 1))
  DEV=$(bashio::jq "$disk" '.device')
  IDLE=$(bashio::jq "$disk" '.idle // empty')
  COMMAND_TYPE=$(bashio::jq "$disk" '.command_type // empty')
  POWER_CONDITION=$(bashio::jq "$disk" '.power_condition // empty')
  require_space_free 'device' "$DEV"
  require_space_free 'idle' "$IDLE"
  require_space_free 'command_type' "$COMMAND_TYPE"
  require_space_free 'power_condition' "$POWER_CONDITION"
  ## The supervisor schema marks idle/command_type/power_condition required, so an empty value here means a
  ## hand-edited options.json. Defense in depth: cheap re-checks keep one from producing a bogus argv.
  [ "$IDLE" != "" ] \
    || bashio::exit.nok "Drive '${DEV}': missing idle time - every drive sets its own (0 = never spin down)."
  [[ "$IDLE" =~ ^[0-9]+$ ]] \
    || bashio::exit.nok "Drive '${DEV}': invalid idle time '${IDLE}': must be a non-negative integer."
  [ "$COMMAND_TYPE" != "" ] \
    || bashio::exit.nok "Drive '${DEV}': missing command type - every drive sets its own (scsi or ata)."
  case "$COMMAND_TYPE" in
    scsi | ata) ;;
    *)
      bashio::exit.nok "Drive '${DEV}': invalid command type '${COMMAND_TYPE}': must be scsi or ata."
      ;;
  esac
  [ "$POWER_CONDITION" != "" ] \
    || bashio::exit.nok "Drive '${DEV}': missing power condition - every drive sets its own (0-15)."
  if ! [[ "$POWER_CONDITION" =~ ^[0-9]+$ ]] || [ "$POWER_CONDITION" -gt 15 ]; then
    bashio::exit.nok "Drive '${DEV}': invalid power condition '${POWER_CONDITION}': must be 0-15."
  fi
  ## Per-drive drive-PM opt-out (bool?), read WITHOUT `// empty` and matched strictly: jq folds an explicit false into
  ## "absent" (root KNOWLEDGE.md §"bashio option consumption"). Absent (null) and false mean the same thing here – the
  ## treatment applies (the default); true exempts the drive. Defense in depth like the re-checks above – the
  ## supervisor normalizes bool options before the app ever sees them
  ## (root KNOWLEDGE.md §"Supervisor: option schema quirks").
  PM=$(bashio::jq "$disk" '.keep_drive_pm')
  case "$PM" in
    true) DRIVE_PM=0 ;;
    false | null) DRIVE_PM=1 ;;
    *)
      bashio::exit.nok "Drive '${DEV}': invalid keep_drive_pm value '${PM}': must be true, false, or unset."
      ;;
  esac
  ## Partition selection grants cgroup access only for the partition node, while hd-idle opens the disk node.
  if [[ "$DEV" == *-part[0-9]* ]]; then
    bashio::exit.nok "Drive '${DEV}' is a partition (by-id path ending in -partN): select the disk itself (the dropdown entry without -partN) - the app needs the whole disk."
  fi

  if RESOLVED=$(resolve_device "$DEV"); then
    if [[ "$RESOLVED" =~ ^sd[a-z]+$ ]]; then
      NAME="$RESOLVED"
    elif [[ "$RESOLVED" =~ ^sd[a-z]+[0-9]+$ ]]; then
      bashio::exit.nok "Drive '${DEV}' resolves to partition ${RESOLVED}: select the disk itself (the dropdown entry without -partN) - the app needs the whole disk."
    else
      qlog_warning "Drive '${DEV}' resolves to ${RESOLVED}, which is not an sd* disk - hd-idle cannot manage it; entry ignored."
      record_resolution "$DEV" "IGNORED"
      continue
    fi
    if [[ -n "${SYSTEM_SEEN[${NAME}]+x}" ]]; then
      bashio::exit.nok "Drive '${DEV}' is the system disk Home Assistant runs from (${NAME}) - it is always excluded from spin-down and cannot be configured as a managed drive."
    fi
    if [[ -n "${SEEN_DEVICES[${NAME}]+x}" ]]; then
      bashio::exit.nok "Drive ${NAME} (${DEV}) is configured more than once: one configuration per disk - remove the redundant entry."
    fi
    SEEN_DEVICES["${NAME}"]=1
    qlog_info "Drive ${DEV} -> ${NAME}"
    record_resolution "$DEV" "$NAME"
    EMIT_NAME="$NAME"
  else
    ## Detached at startup: pass the path through for hd-idle's runtime resolution (-s 1; cgroup access is granted
    ## dynamically on hotplug); the watcher restarts hd-idle once it resolves (hd-idle/KNOWLEDGE.md §"hd-idle-watch design").
    qlog_warning "Drive '${DEV}' does not resolve right now (detached or still enumerating?) - passing it through for hd-idle's runtime resolution."
    record_resolution "$DEV" "PASSTHRU"
    EMIT_NAME="$DEV"
  fi

  if [ "$IDLE" = "0" ]; then
    qlog_info "Drive ${DEV}: idle time 0 – never spun down."
  fi
  ARGS+=(-a "$EMIT_NAME" -i "$IDLE" -c "$COMMAND_TYPE" -p "$POWER_CONDITION")

  ## Per-drive values for the drives-file line (format: hd-idle/KNOWLEDGE.md §"Drive-PM treatment");
  ## the 4th column is the drive-PM treatment flag.
  DRIVES_LINES+=("${EMIT_NAME} ${IDLE} ${COMMAND_TYPE} ${DRIVE_PM}")
done < <(echo "$DISKS")

if [ "$N_DRIVES" -eq 0 ]; then
  qlog_warning "No drives are listed - hd-idle will not spin down anything. Add the drives you want managed to the drive list (device access is granted per listed drive only)."
fi

## ---------------------------------------------------------------------------
## Global flags + command line output
## ---------------------------------------------------------------------------

if bashio::config.true 'debug'; then
  ARGS+=(-d)
fi
if bashio::config.true 'ignore_spin_down_detection'; then
  ARGS+=(-I)
fi
if bashio::config.true 'activity_log'; then
  ARGS+=(-l "$LOG_FILE")
  qlog_info "Detailed activity log: ${LOG_FILE}"
fi

printf '%s\n' "${ARGS[*]}" >"$ARGS_FILE"
printf '%s\n' "${DRIVES_LINES[@]}" >"$DRIVES_FILE"

## Baseline state for the --check replay: shas of the two files just written plus the detection facts they were
## generated from. Written LAST – the commit point of the three-file install; a crash before it is re-synced next tick.
ARGS_SHA=$(sha256sum "$ARGS_FILE")
DRIVES_SHA=$(sha256sum "$DRIVES_FILE")
{
  printf '# hd-idle resolution baseline: written by hd-idle-genargs, replayed by its --check mode\n'
  printf 'args %s\n' "${ARGS_SHA%% *}"
  printf 'drives %s\n' "${DRIVES_SHA%% *}"
  if [ "${#SYSTEM_SD_DISKS[@]}" -gt 0 ]; then
    printf 'system %s\n' "${SYSTEM_SD_DISKS[*]}"
  else
    printf 'system\n'
  fi
  for dev in "${RECORD_DEVICES[@]}"; do
    printf 'dev %s %s\n' "$dev" "${RECORD_RESOLVED[${dev}]}"
  done
} >"$STATE_FILE"
qlog_info "hd-idle command line: /usr/sbin/hd-idle ${ARGS[*]}"
qlog_info "hd-idle configuration completed"
