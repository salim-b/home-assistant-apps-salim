#!/bin/bash
# Docker HEALTHCHECK probe: hd-idle exits itself (log.Fatal, then s6 restarts it) if /proc/diskstats becomes
# unreadable - check the stats file and the daemon process (plain /proc/*/comm scan, no pgrep dependency).
set -euo pipefail

[ -r /proc/diskstats ]
for comm in /proc/[0-9]*/comm; do
  if [ "$(cat "${comm}" 2>/dev/null || true)" = "hd-idle" ]; then
    exit 0
  fi
done
exit 1
