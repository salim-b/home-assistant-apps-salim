#!/bin/bash
# Docker HEALTHCHECK probe: checks the stats file and the daemon process (plain /proc/*/comm scan, no pgrep
# dependency; the read builtin spawns no process per checked PID – the probe runs every 30 s). What it guards
# against and why both checks: the Dockerfile HEALTHCHECK comment.
set -euo pipefail

[ -r /proc/diskstats ] || exit 1
comm=""
for f in /proc/[0-9]*/comm; do
  read -r comm 2>/dev/null <"$f" || continue
  [ "$comm" = "hd-idle" ] && exit 0
done
exit 1
