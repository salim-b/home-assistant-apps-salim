#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## The app's drive-PM treatment: disable the drives' own power management for pm-flag-1 drives-file lines –
## semantics, drives-file format, --since and concurrency: hd-idle/KNOWLEDGE.md §"Drive-PM treatment";
## user-facing behavior: DOCS.md.
##
## Usage: hd-idle-pmfix <drives-file> [--since <old-drives-file>]

DRIVES_FILE="${1:-/etc/hd-idle.drives}"
SINCE_FILE=""

case "${2:-}" in
  --since)
    [ "${3:-}" != "" ] || {
      bashio::log.error "hd-idle-pmfix: --since needs a file argument"
      exit 1
    }
    SINCE_FILE="$3"
    ;;
  "") ;;
  *)
    bashio::log.error "hd-idle-pmfix: unknown argument '${2}'"
    exit 1
    ;;
esac

[ -r "$DRIVES_FILE" ] || {
  bashio::log.warning "hd-idle-pmfix: no drives file (${DRIVES_FILE}) - nothing to treat"
  exit 0
}

# Success detection (rc=0 AND no failed|unknown|unavailable output), the -d sat pin and timeout 60 – rationale:
# hd-idle/KNOWLEDGE.md §"Drive-PM treatment". The detail grep's different word list only picks a log line for the
# failure message, truncated to 80 chars: wide enough for full sense messages ("scsi error device will be ready
# soon"), still one short log line.
smart() {
  local dev="$1" flag="$2" value="$3" out rc attempt
  for attempt in 1 2 3 4; do
    if [ "$attempt" -gt 1 ]; then sleep 10; fi
    out=$(timeout 60 smartctl -d sat -s "${flag},${value}" "/dev/${dev}" 2>&1) && rc=0 || rc=$?
    if [ "$rc" = 0 ] && ! grep -qiE 'failed|unknown|unavailable' <<<"$out"; then
      if [ "$attempt" -gt 1 ]; then printf 'ok (attempt %s)' "$attempt"; else printf 'ok'; fi
      return 0
    fi
    # Retry filter: the NOT READY family only – timed-out and other failures never retry. Rationale (the rc alone
    # is too broad): hd-idle/KNOWLEDGE.md §"Drive-PM treatment".
    if [ "$rc" != 0 ] && grep -qiE 'will be ready soon|device not ready' <<<"$out"; then
      continue
    fi
    break
  done
  printf 'rc=%s (%s)' "$rc" "$(grep -aiE 'failed|unavailable|aborted|invalid' <<<"$out" | head -1 | sed 's/^smartctl [^|]*//;s/^ *//' | cut -c1-80)"
}

is_treated_before() {
  [ "$SINCE_FILE" != "" ] && [ -r "$SINCE_FILE" ] \
    && grep -qxF "$1" "$SINCE_FILE"
}

## Treatment targets: pm-flag-1 lines with a resolved sd* kernel name (a drive detached at boot appears under its
## by-id path and is skipped; the watcher's next cycle treats it under its resolved name). Treated drives dispatch
## to background jobs; each job writes its log line to a temp file numbered by drives-file order, logged after
## `wait` – the log stays deterministic despite the concurrent smartctl calls.
RESULT_DIR=$(mktemp -d)
trap 'rm -rf "${RESULT_DIR}"' EXIT
TREATED=0
while read -r name idle ctype pmflag; do
  [ "${name:-}" != "" ] || continue
  [[ "$name" =~ ^sd[a-z]+$ ]] || continue
  if is_treated_before "${name} ${idle} ${ctype} ${pmflag}"; then
    if [ "$pmflag" = "1" ]; then
      bashio::log.info "Drive ${name}: power management already disabled (unchanged configuration) - skipping."
    else
      bashio::log.info "Drive ${name}: drive-PM treatment disabled for this drive (configuration unchanged) - skipping."
    fi
    continue
  fi
  if [ "$pmflag" != "1" ]; then
    bashio::log.info "Drive ${name}: drive-PM treatment disabled for this drive - its own power management stays as is."
    continue
  fi
  TREATED=$((TREATED + 1))
  (
    apm=$(smart "$name" "apm" "off")
    stby=$(smart "$name" "standby" "off")
    printf 'Drive %s: APM disable %s; standby timer disable %s.\n' "$name" "$apm" "$stby" \
      >"${RESULT_DIR}/${TREATED}"
  ) &
done <"$DRIVES_FILE"
wait
for ((i = 1; i <= TREATED; i++)); do
  if [ -s "${RESULT_DIR}/${i}" ]; then
    bashio::log.info "$(cat "${RESULT_DIR}/${i}")"
  else
    bashio::log.warning "Treatment result ${i} missing - its concurrent job failed to record it."
  fi
done
