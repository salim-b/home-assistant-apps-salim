#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## Disable the drives' own power management (APM level + internal standby timer) - the app's drive-PM treatment
## (global option disable_drive_pm as the default, per-drive disable_drive_pm yes/no overrides; the drives file's
## pm-flag column carries the effective per-drive decision). Why, per-bridge reality, volatility, and the known
## same-kernel-name gap: hd-idle/KNOWLEDGE.md §"Drive-PM treatment"; user-facing behavior: DOCS.md.
##
## Usage: hd-idle-pmfix <drives-file> [--since <old-drives-file>]
## <drives-file>: one "<kernel-name> <idle> <command-type> <pm-flag>" line per drive (written by hd-idle-genargs
## next to the args file; format: hd-idle/KNOWLEDGE.md §"Drive-PM treatment"). Only drives with idle != 0 AND
## pm-flag 1 are treated. With --since, only drives whose line is NEW or CHANGED relative to the old file are
## treated (re-treating an already-treated drive risks bridge-mediated motor starts).

DRIVES_FILE="${1:-/etc/hd-idle.drives}"
SINCE_FILE=""

case "${2:-}" in
  --since)
    [ -n "${3:-}" ] || { bashio::log.error "hd-idle-pmfix: --since needs a file argument"; exit 1; }
    SINCE_FILE="$3"
    ;;
  "") ;;
  *) bashio::log.error "hd-idle-pmfix: unknown argument '${2}'"; exit 1 ;;
esac

[ -r "${DRIVES_FILE}" ] || { bashio::log.warning "hd-idle-pmfix: no drives file (${DRIVES_FILE}) - nothing to treat"; exit 0; }

smart() {
  local dev="$1" flag="$2" value="$3" out rc
  out=$(timeout 60 smartctl -d sat -s "${flag},${value}" "/dev/${dev}" 2>&1) && rc=0 || rc=$?
  if [ "$rc" = 0 ] && ! grep -qiE 'failed|unknown|unavailable' <<<"$out"; then
    printf 'ok'
  else
    printf 'rc=%s (%s)' "$rc" "$(grep -aiE 'failed|unavailable|aborted|invalid' <<<"$out" | head -1 | sed 's/^smartctl [^|]*//;s/^ *//' | cut -c1-60)"
  fi
}

is_treated_before() {
  [ -n "${SINCE_FILE}" ] && [ -r "${SINCE_FILE}" ] &&
    grep -qxF "$1" "${SINCE_FILE}"
}

## Entries are "<name> <idle> <command-type> <pm-flag>"; only resolved sd* disks with a non-zero idle and pm-flag 1
## are treatment targets. A missing pm-flag (a pre-0.1.6 3-column file - cannot occur in practice, the drives file
## is always regenerated by the genargs version that runs pmfix) means treat, the former global-default-on
## behavior.
while read -r name idle ctype pmflag; do
  pmflag="${pmflag:-1}"
  [ -n "${name:-}" ] || continue
  [ "${idle:-0}" != "0" ] || continue
  [[ "${name}" =~ ^sd[a-z]+$ ]] || continue
  if is_treated_before "${name} ${idle} ${ctype} ${pmflag}"; then
    if [ "${pmflag}" = "1" ]; then
      bashio::log.info "Drive ${name}: power management already disabled (unchanged configuration) - skipping."
    else
      bashio::log.info "Drive ${name}: drive-PM treatment disabled for this drive (configuration unchanged) - skipping."
    fi
    continue
  fi
  if [ "${pmflag}" != "1" ]; then
    bashio::log.info "Drive ${name}: drive-PM treatment disabled for this drive - its own power management stays as is."
    continue
  fi
  apm=$(smart "${name}" "apm" "off")
  stby=$(smart "${name}" "standby" "off")
  bashio::log.info "Drive ${name}: APM disable ${apm}; standby timer disable ${stby}."
done <"${DRIVES_FILE}"
