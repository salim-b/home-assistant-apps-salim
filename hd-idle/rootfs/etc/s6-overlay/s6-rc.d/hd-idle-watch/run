#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## Drive re-resolution watcher (longrun service): kernel names are not stable across re-plugs and hd-idle's -s 1 never
## re-verifies already-resolved entries, so a moved drive would keep its stale entry until an app restart. Each tick
## replays the recorded resolution baseline (hd-idle-genargs --check) and only on a detected change regenerates and
## restarts just the hd-idle service. Problem, design, restart effects, failure class:
## hd-idle/KNOWLEDGE.md §"hd-idle-watch design".

## Poll interval (seconds); HD_IDLE_WATCH_INTERVAL overrides the 30 s default (the lab sets 5 s). Invalid values fall
## back to the default, floored at 5 s so a bogus value cannot busy-cycle the tick.
INTERVAL="${HD_IDLE_WATCH_INTERVAL:-30}"
case "$INTERVAL" in
  '' | *[!0-9]*)
    bashio::log.warning "Invalid HD_IDLE_WATCH_INTERVAL '${INTERVAL}' - using the 30 s default."
    INTERVAL=30
    ;;
esac
[ "$INTERVAL" -ge 5 ] || INTERVAL=5

ARGS_FILE=/etc/hd-idle.args
CAND_FILE=/tmp/hd-idle-args.new
## Companion files of the args file (derivation mirrored from hd-idle-genargs' companion_file; absolute paths here).
DRIVES_FILE="${ARGS_FILE%.args}.drives"
CAND_DRIVES_FILE="${CAND_FILE%.args}.drives"
STATE_FILE="${ARGS_FILE%.args}.resolution"
CAND_STATE_FILE="${CAND_FILE%.args}.resolution"

while true; do
  sleep "$INTERVAL"

  ## Detect (read-only): 0 = unchanged, 3 = changed (regeneration due), other = check failure; mid-run failures are
  ## nearly impossible by construction, so the keep-current guard is cheap insurance.
  RC=0
  /usr/bin/hd-idle-genargs --quiet --check || RC=$?

  if [ "$RC" = 0 ]; then
    continue
  fi
  if [ "$RC" != 3 ]; then
    bashio::log.warning "Checking the hd-idle configuration failed - keeping the current configuration."
    continue
  fi

  ## Regenerate from current options + current device resolution.
  if ! /usr/bin/hd-idle-genargs --quiet "$CAND_FILE"; then
    bashio::log.warning "hd-idle configuration regeneration failed - keeping the current configuration."
    continue
  fi

  ## Regenerated args AND drives still matching the installed ones = only the baseline state is stale (interrupted
  ## install, or a resolution change that reverted): resync the state file without a restart.
  if cmp -s "$ARGS_FILE" "$CAND_FILE" && cmp -s "$DRIVES_FILE" "$CAND_DRIVES_FILE"; then
    if ! cmp -s "$STATE_FILE" "$CAND_STATE_FILE"; then
      mv -f "$CAND_STATE_FILE" "$STATE_FILE"
    fi
    rm -f "$CAND_FILE" "$CAND_DRIVES_FILE" "$CAND_STATE_FILE"
    continue
  fi

  ## The new command line is logged by the hd-idle run script after the restart; unchanged ticks log nothing.
  bashio::log.info "Drive device paths changed - updating the hd-idle configuration and restarting hd-idle"
  ## Keep the previous drives file for hd-idle-pmfix (--since): only NEW or CHANGED drives get the (possibly
  ## wake-causing) treatment re-applied.
  cp "$DRIVES_FILE" "${DRIVES_FILE}.prev" 2>/dev/null || true
  mv -f "$CAND_FILE" "$ARGS_FILE"
  mv -f "$CAND_DRIVES_FILE" "$DRIVES_FILE"
  ## State file last: the commit point of the three-file install (records the shas just installed); a crash before
  ## it leaves the shas mismatching, and the next tick re-syncs.
  mv -f "$CAND_STATE_FILE" "$STATE_FILE"
  ## Unconditional: the pm-flag column carries the effective per-drive decision; pmfix skips pm-flag-0 drives.
  /usr/bin/hd-idle-pmfix "$DRIVES_FILE" --since "${DRIVES_FILE}.prev" \
    || bashio::log.warning "hd-idle-pmfix failed - the drives' power management stays as is."
  if ! s6-svc -r /run/service/hd-idle; then
    bashio::log.warning "Restarting the hd-idle service failed - it will pick up the new configuration on its next restart."
  fi
done
