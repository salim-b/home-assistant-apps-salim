#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## hd-idle daemon (longrun service). Reads the generated argument list (/etc/hd-idle.args; written by cont-init
## config.sh, regenerated + restarted by hd-idle-watch when drive paths move; see hd-idle/KNOWLEDGE.md). `exec`
## makes hd-idle this service's process: s6 signals it directly on stop, and its stdout lands in the app log.
## Fail with a clear message (s6 restarts this service) instead of bash's raw redirect error if config.sh did not finish.
if [ ! -r /etc/hd-idle.args ]; then
  bashio::log.error "/etc/hd-idle.args is missing - the hd-idle configuration did not complete (see the earlier log lines for the configuration error)."
  exit 1
fi
read -r -a HD_IDLE_ARGS </etc/hd-idle.args
bashio::log.info "Starting hd-idle: /usr/sbin/hd-idle ${HD_IDLE_ARGS[*]}"
exec /usr/sbin/hd-idle "${HD_IDLE_ARGS[@]}"
