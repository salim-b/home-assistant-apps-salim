#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

## hd-idle daemon (longrun service). Reads the generated argument list (/etc/hd-idle.args: written by cont-init
## config.sh, regenerated + restarted by hd-idle-watch when drive paths move; see hd-idle/KNOWLEDGE.md). `exec` makes
## hd-idle this service's process: s6 signals it directly on stop, and its stdout (spin-down/spin-up events, debug
## lines) lands in the app log.
read -r -a HD_IDLE_ARGS </etc/hd-idle.args
bashio::log.info "Starting hd-idle: /usr/sbin/hd-idle ${HD_IDLE_ARGS[*]}"
exec /usr/sbin/hd-idle "${HD_IDLE_ARGS[@]}"
