amends "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Builtins.pkl"

// hk's shebang-based file typing misses the extensionless s6 scripts (upstream item: root TODO.md).
// `match_any` REPLACES a step's default selection (frozen by the pinned package version), so each
// shell step below repeats the builtin's own selectors plus s6Globs.
local s6Globs = List(
  "**/cont-init.d/*",
  "**/s6-overlay/scripts/*",
  "**/s6-rc.d/*/run",
  "**/s6-rc.d/*/finish",
)
local mdGlobs = List("**/*.md", "**/*.markdown")
// Explicit paths bypass panache's config excludes; AI_POLICY.md is upstream-verbatim, **/LICENSE.md mirrors the default Markdown exclude.
local mdExcludes = List("AI_POLICY.md", "**/LICENSE.md")

local linters = new Mapping<String, Step> {
  // -disable-indent-size: padding here is marker/string-driven (Markdown list indents, quoted
  // string continuations), so the indent_size multiple rule is noise - shell indentation is the
  // shfmt step's job (.editorconfig). Every other EditorConfig rule stays in force.
  ["editorconfig-checker"] = (Builtins.editorconfig_checker) {
    check {
      command {
        argv = List("editorconfig-checker", "-disable-indent-size", "{{files}}")
      }
    }
    fix {
      command {
        argv = List("editorconfig-checker", "-disable-indent-size", "--fix", "{{files}}")
      }
    }
  }
  // -x follows `source`d helpers (.mise/tasks/lib/ - without it SC1091); the fix-mode check_diff path needs the same flag.
  ["shellcheck"] = (Builtins.shellcheck) {
    match_any = List(
      new FileSelector { glob = List("**/*.sh", "**/*.bash") },
      new FileSelector { types = List("sh", "bash") },
      new FileSelector { glob = s6Globs },
    )
  }
  ["shfmt"] = (Builtins.shfmt) {
    match_any = List(
      new FileSelector {
        glob = List("**/*.sh", "**/*.bash", "**/*.mksh", "**/*.bats", "**/*.zsh")
      },
      new FileSelector { types = List("sh", "bash") },
      new FileSelector { glob = s6Globs },
    )
  }
  ["shellharden"] = (Builtins.shellharden) {
    // The builtin's step-level `types` cannot coexist with `match_any` - cleared and re-declared as a selector.
    types = null
    match_any = List(
      new FileSelector { types = List("bash", "sh") },
      new FileSelector { glob = s6Globs },
    )
  }
  ["actionlint"] = Builtins.actionlint
  ["hadolint"] = Builtins.hadolint
  // ryl (Rust yamllint re-implementation, configured in .ryl.toml); --strict on check and fix so
  // the .ryl.toml warning-level rules keep blocking (fix's exit code is then self-verifying).
  // check_diff/check_after_diff are cleared: hk's fix mode skips the fixer when check_diff exits
  // 0, but ryl's --diff exits 0 even for unfixable findings (verified 2026-10-20; upstream: root TODO.md).
  ["ryl"] = (Builtins.ryl) {
    check_diff = null
    check_after_diff = false
    check_list_files = null
    check {
      command {
        argv = List("ryl", "check", "--strict", "{{files}}")
      }
    }
    fix {
      command {
        argv = List("ryl", "check", "--fix", "--strict", "{{files}}")
      }
    }
  }
  // Panache owns ALL Markdown formatting (.agents/skills/ha-app-markdown, .panache.toml); explicit
  // paths bypass panache's config excludes, hence mdExcludes.
  ["panache-format"] {
    glob = mdGlobs
    exclude = mdExcludes
    check = "panache format --check {{files}}"
    fix = "panache format {{files}}"
  }
  // Semantic lint (references, heading hierarchy, ...); not auto-fixable.
  ["panache-lint"] {
    glob = mdGlobs
    exclude = mdExcludes
    check = "panache lint {{files}}"
  }
  // rumdl stays a check-only second linter (repo policy): never a fix step.
  ["rumdl"] = Builtins.rumdl
  ["final-newline"] = Builtins.newlines
}

steps = linters

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}
