// The package version must stay in sync with the hk binary pin in mise.toml [tools] – the package provides the
// builtin step definitions the binary executes.
amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

  // hk's shebang-based file typing misses the extensionless s6 scripts and the apps' /usr/bin scripts
  // (upstream item: root TODO.md). `match_any` REPLACES a step's default selection (frozen by the
  // pinned package version), so each shell step below repeats the builtin's own selectors plus the
  // added globs.
  local s6Globs = List(
    "**/cont-init.d/*",
    "**/s6-overlay/scripts/*",
    "**/s6-rc.d/*/run",
    "**/s6-rc.d/*/finish",
  )
  // The apps' extension-less /usr/bin scripts (bashio shebangs – same typing gap); all three shell steps cover them.
  local appBinGlobs = List("**/rootfs/usr/bin/*")
local mdGlobs = List("**/*.md", "**/*.markdown")
// AI_POLICY.md is upstream-verbatim; **/LICENSE.md mirrors panache's default Markdown exclude
// (explicit-path bypass: skill ha-app-markdown).
local mdExcludes = List("AI_POLICY.md", "**/LICENSE.md")

local linters = new Mapping<String, Step> {
  ["editorconfig-checker"] = (Builtins.editorconfig_checker) {
    check {
      command {
        argv = List("editorconfig-checker", "-disable-indent-size", "{{files}}")
      }
    }
    fix {
      command {
        argv = List("editorconfig-checker", "-disable-indent-size", "--fix", "{{files}}")
      }
    }
  }
  // -x follows `source`d helpers (.mise/tasks/lib/ – without it SC1091); the fix-mode check_diff path needs the same flag.
  ["shellcheck"] = (Builtins.shellcheck) {
    match_any = List(
      new FileSelector { glob = List("**/*.sh", "**/*.bash") },
      new FileSelector { types = List("sh", "bash") },
      new FileSelector { glob = s6Globs },
      new FileSelector { glob = appBinGlobs },
    )
  }
  ["shfmt"] = (Builtins.shfmt) {
    match_any = List(
      new FileSelector {
        glob = List("**/*.sh", "**/*.bash", "**/*.mksh", "**/*.bats", "**/*.zsh")
      },
      new FileSelector { types = List("sh", "bash") },
      new FileSelector { glob = s6Globs },
      new FileSelector { glob = appBinGlobs },
    )
  }
  ["shellharden"] = (Builtins.shellharden) {
    // The builtin's step-level `types` cannot coexist with `match_any` – cleared and re-declared as a selector.
    types = null
    match_any = List(
      new FileSelector { types = List("bash", "sh") },
      new FileSelector { glob = s6Globs },
      new FileSelector { glob = appBinGlobs },
    )
  }
  // jactionlint (maintained actionlint fork, hk builtin); profile/per-rule policy: .github/jactionlint.yaml.
  ["jactionlint"] = Builtins.jactionlint
  // droast (Dockerfile linter, hk builtin); project-level skips: droast.toml.
  ["droast"] = Builtins.droast
  // zizmor (GitHub Actions security audit, hk builtin); rule policy: .github/zizmor.yml. Mode/token
  // conventions: .agents/skills/ha-app-tooling.
  ["zizmor"] = (Builtins.zizmor) {
    check {
      command {
        argv = List("zizmor", "-qq", "--no-progress", "{{files}}")
      }
    }
    fix {
      command {
        argv = List("zizmor", "-qq", "--no-progress", "--fix", "{{files}}")
      }
    }
  }
  // Official Renovate config validation (why the flags: .agents/skills/ha-app-tooling).
  ["renovate-config-validator"] {
    glob = List(".github/renovate.json", ".github/renovate.json5")
    check = "renovate-config-validator --no-global --strict {{files}}"
  }
  // ryl (Rust yamllint re-implementation, configured in .ryl.toml); --strict on check and fix.
  // check_diff/check_after_diff are cleared on purpose – why: .agents/skills/ha-app-tooling (upstream: root TODO.md).
  ["ryl"] = (Builtins.ryl) {
    check_diff = null
    check_after_diff = false
    check_list_files = null
    check {
      command {
        argv = List("ryl", "check", "--strict", "{{files}}")
      }
    }
    fix {
      command {
        argv = List("ryl", "check", "--fix", "--strict", "{{files}}")
      }
    }
  }
  // tombi (TOML linter/formatter): schemas bind per-file via `#:schema` top directives
  // (strict mode – unknown keys are errors).
  ["tombi-format"] = Builtins.tombi_format
  // tombi exits 0 on its warn-severity rules by default, so --error-on-warnings makes them gate-fail
  // Conventions: .agents/skills/ha-app-tooling
  ["tombi-lint"] = (Builtins.tombi) {
    check {
      command {
        argv = List("tombi", "lint", "--quiet", "--error-on-warnings", "{{files}}")
      }
    }
  }
  // config: .ruff.toml; conventions: .agents/skills/ha-app-tooling
  ["ruff-format"] = Builtins.ruff_format
  ["ruff"] = Builtins.ruff
  // ty (Python type checker; config: ty.toml)
  ["ty"] = Builtins.ty
  // Panache owns ALL Markdown formatting (.agents/skills/ha-app-markdown, .panache.toml); explicit
  // paths bypass panache's config excludes, hence mdExcludes.
  ["panache-format"] {
    glob = mdGlobs
    exclude = mdExcludes
    check = "panache format --check {{files}}"
    fix = "panache format {{files}}"
  }
  // Semantic lint (references, heading hierarchy, ...); not auto-fixable.
  ["panache-lint"] {
    glob = mdGlobs
    exclude = mdExcludes
    check = "panache lint {{files}}"
  }
  // rumdl stays a check-only second linter (repo policy): never a fix step.
  ["rumdl"] = Builtins.rumdl
  ["final-newline"] = Builtins.newlines
}

steps = linters

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}
