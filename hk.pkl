amends "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Builtins.pkl"

// The shell builtins select scripts by extension and shebang (hk file
// typing). That misses the extensionless s6 scripts: their
// `#!/usr/bin/with-contenv bashio` shebangs type as plain text, not bash - so
// the shell steps also match those paths by glob (s6-overlay convention makes
// them shell scripts). `match_any` replaces a step's default selection, so
// each step below repeats the builtin's own selectors (frozen by the pinned
// package version) plus s6Globs.
local s6Globs = List(
  "**/cont-init.d/*",
  "**/s6-overlay/scripts/*",
  "**/s6-rc.d/*/run",
  "**/s6-rc.d/*/finish",
)
local mdGlobs = List("**/*.md", "**/*.markdown")
// Explicit paths bypass panache's own config excludes; AI_POLICY.md is
// upstream-verbatim, **/LICENSE.md mirrors the default Markdown exclude.
local mdExcludes = List("AI_POLICY.md", "**/LICENSE.md")

local linters = new Mapping<String, Step> {
  // Left-padding in this repo is marker- or string-driven (Markdown list
  // indents, quoted string continuations), so the "multiple of indent_size"
  // rule is noise: `-disable-indent-size` drops it on the check and the fix
  // command alike, and every other EditorConfig rule stays in force. Shell
  // indentation is governed by the shfmt step (which reads `indent_size`
  // from `.editorconfig`); the one class shfmt cannot see is padding inside
  //  quoted multi-line strings – kept at even multiples by hand.
  ["editorconfig-checker"] = (Builtins.editorconfig_checker) {
    check {
      command {
        argv = List("editorconfig-checker", "-disable-indent-size", "{{files}}")
      }
    }
    fix {
      command {
        argv = List("editorconfig-checker", "-disable-indent-size", "--fix", "{{files}}")
      }
    }
  }
  // -x follows `source`d helpers (.mise/tasks/lib/); without it the sourced
  // helper fails with SC1091. The fix-mode autofix path (check_diff) needs
  // the same flag.
  ["shellcheck"] = (Builtins.shellcheck) {
    match_any = List(
      new FileSelector { glob = List("**/*.sh", "**/*.bash") },
      new FileSelector { types = List("sh", "bash") },
      new FileSelector { glob = s6Globs },
    )
  }
  ["shfmt"] = (Builtins.shfmt) {
    match_any = List(
      new FileSelector {
        glob = List("**/*.sh", "**/*.bash", "**/*.mksh", "**/*.bats", "**/*.zsh")
      },
      new FileSelector { types = List("sh", "bash") },
      new FileSelector { glob = s6Globs },
    )
  }
  ["shellharden"] = (Builtins.shellharden) {
    // The builtin matches via step-level `types`, which cannot coexist with
    // `match_any` - so it is cleared here and re-declared as a selector.
    types = null
    match_any = List(
      new FileSelector { types = List("bash", "sh") },
      new FileSelector { glob = s6Globs },
    )
  }
  ["actionlint"] = Builtins.actionlint
  ["hadolint"] = Builtins.hadolint
  // Builtins.ryl (Rust yamllint re-implementation, configured in .ryl.toml)
  // with --strict added to check and fix: the .ryl.toml ruleset leans on
  // warning-level rules (line-length, comments, document-start, truthy) and
  // yamllint's builtin failed on warnings too - without --strict they would
  // stop blocking (verified clean over all tracked yaml). The builtin's fix
  // step auto-fixes mechanical issues (spacing, final newline, quoting) in
  // pre-commit; --strict makes its exit code self-verifying (0 only when
  // nothing remains to fix or flag). check_diff/check_after_diff are
  // cleared: ryl's --diff exits 0 whenever it has no patch - including
  // unfixable findings - so hk's fix mode would skip the fixer and pass
  // files that still violate (leak verified 2026-10-20); running fix (with
  // --strict) on every staged yaml file both fixes and verifies instead.
  ["ryl"] = (Builtins.ryl) {
    check_diff = null
    check_after_diff = false
    check_list_files = null
    check {
      command {
        argv = List("ryl", "check", "--strict", "{{files}}")
      }
    }
    fix {
      command {
        argv = List("ryl", "check", "--fix", "--strict", "{{files}}")
      }
    }
  }
  // Panache owns ALL Markdown formatting (panache.toml). Explicit paths
  // bypass its config excludes, hence mdExcludes. The only Markdown
  // auto-fix step.
  ["panache-format"] {
    glob = mdGlobs
    exclude = mdExcludes
    check = "panache format --check {{files}}"
    fix = "panache format {{files}}"
  }
  // Semantic lint (references, heading hierarchy, ...); not auto-fixable.
  ["panache-lint"] {
    glob = mdGlobs
    exclude = mdExcludes
    check = "panache lint {{files}}"
  }
  // rumdl stays a check-only second linter (repo policy): never a fix step.
  ["rumdl"] = Builtins.rumdl
  ["final-newline"] = Builtins.newlines
}

steps = linters

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}
